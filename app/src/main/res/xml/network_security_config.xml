<?xml version="1.0" encoding="utf-8"?>
<!-- A self-hosted Rotation usually answers over plain http on a private
     address, so cleartext has to stay allowed. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
